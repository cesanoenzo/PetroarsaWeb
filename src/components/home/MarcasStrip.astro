---
import marcas from '../../data/marcas-partners.json';
import { asset } from '../../lib/url';
---

<section class="border-y border-brand-line bg-brand-bg-alt py-12">
  <div class="contenedor">
    <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-brand-ink-soft">
      Representamos a
    </p>

    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-8 sm:gap-x-14">
      {
        marcas.map((m) => (
          <li class="revelar">
            {/* max-w normaliza ópticamente logos de proporciones muy distintas:
                VARTA es 5:1 y Bridgestone 1.8:1, con alto fijo uno se comería
                al otro. */}
            <img
              src={asset(m.logo)}
              alt={m.nombre}
              width={m.ancho}
              height={m.alto}
              loading="lazy"
              decoding="async"
              class="h-8 w-auto max-w-[9rem] object-contain opacity-80 transition-opacity duration-300 hover:opacity-100 sm:h-9 sm:max-w-[11rem]"
            />
            <span class="sr-only">Desde {m.desde}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
