---
import { Icon } from 'astro-icon/components';
import empresa from '../../data/empresa.json';
import { asset, ruta } from '../../lib/url';

const anios = new Date().getFullYear() - empresa.fundacion;

const stats = [
  { valor: empresa.colaboradores, texto: 'colaboradores', icono: 'lucide:users' },
  { valor: String(empresa.puntosDeVenta), texto: 'puntos de venta', icono: 'lucide:map-pin' },
  { valor: `${anios}`, texto: 'años de trayectoria', icono: 'lucide:calendar-days' },
];
---

<section class="relative isolate overflow-hidden bg-[#0c1f1a]">
  <!-- Banner institucional de las gacetillas: EESS + neumáticos + agro -->
  <img
    src={asset('/imagenes/hero/hero-petroarsa.jpg')}
    alt=""
    aria-hidden="true"
    width="2254"
    height="564"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover opacity-70"
  />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, rgba(12,31,26,.55) 0%, rgba(12,31,26,.78) 55%, rgba(12,31,26,.94) 100%)"
  >
  </div>

  <div class="contenedor relative py-24 sm:py-32 lg:py-40">
    <p class="animate-fade-up text-xs font-bold uppercase tracking-[0.22em] text-brand-accent-light">
      Tucumán · desde {empresa.fundacion}
    </p>

    <h1 class="animate-fade-up mt-5 max-w-4xl text-4xl leading-[1.05] text-white sm:text-6xl lg:text-7xl">
      Energía, campo y movilidad
      <span class="block text-brand-accent-light">para el NOA</span>
    </h1>

    <p class="animate-fade-up mt-6 max-w-2xl text-lg leading-relaxed text-white/80 sm:text-xl">
      Distribución mayorista YPF, estaciones de servicio propias y centro de servicios
      Bridgestone. Casi 30 años acompañando el crecimiento de nuestros clientes.
    </p>

    <div class="animate-fade-up mt-9 flex flex-wrap gap-3">
      <a href="#unidades" class="btn-acento">
        Ver unidades de negocio
        <Icon name="lucide:arrow-down" class="h-4 w-4" />
      </a>
      <a href={ruta('/contacto/')} class="btn border border-white/40 text-white hover:bg-white/10">
        Contactanos
      </a>
    </div>

    <!-- Stat cards -->
    <dl class="mt-16 grid max-w-3xl grid-cols-1 gap-3 sm:grid-cols-3">
      {
        stats.map((s, i) => (
          <div
            class="revelar rounded-2xl border border-white/15 bg-white/[0.07] px-5 py-6 backdrop-blur-sm"
            style={`transition-delay:${i * 90}ms`}
          >
            <Icon name={s.icono} class="h-5 w-5 text-brand-accent-light" />
            <dt class="sr-only">{s.texto}</dt>
            <dd class="mt-3">
              <span class="block font-display text-4xl font-bold text-white">{s.valor}</span>
              <span class="mt-1 block text-sm text-white/60">{s.texto}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
