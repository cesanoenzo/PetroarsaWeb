---
import { Icon } from 'astro-icon/components';
import UnidadLayout from './UnidadLayout.astro';
import ProductGallery from '../components/producto/ProductGallery.astro';
import ProductSpecs from '../components/producto/ProductSpecs.astro';
import DescargarFicha from '../components/producto/DescargarFicha.astro';
import ProductCard from '../components/unidad/ProductCard.astro';
import SectionTitle from '../components/shared/SectionTitle.astro';
import type { Producto, UnidadId } from '../lib/catalogo';
import { ruta } from '../lib/url';

interface Props {
  producto: Producto;
  unidad: UnidadId;
  relacionados: Producto[];
}

const { producto, unidad, relacionados } = Astro.props;
const p = producto.data;

const hrefConsulta = ruta(`/contacto/?unidad=${unidad}`);
---

<UnidadLayout
  unidad={unidad}
  titulo={`${p.titulo} — ${p.marca}`}
  descripcion={p.descripcionCorta}
  imagenOG={p.imagenPrincipal}
  migas={[{ texto: p.titulo }]}
>
  <div class="contenedor py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,26rem)_1fr] lg:gap-14">
      <!-- Galería -->
      <div class="lg:sticky lg:top-24 lg:self-start">
        <ProductGallery
          principal={p.imagenPrincipal}
          secundarias={p.imagenesSecundarias}
          alt={p.titulo}
        />
      </div>

      <!-- Info -->
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-primary">
          {p.marca} · {p.categoria}{p.subcategoria ? ` · ${p.subcategoria}` : ''}
        </p>

        <h1 class="mt-3 text-3xl leading-tight text-brand-ink sm:text-4xl">{p.titulo}</h1>

        <p class="mt-4 text-lg leading-relaxed text-brand-ink-soft">{p.descripcionCorta}</p>

        {
          p.tags && p.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <li class="etiqueta normal-case">{t}</li>
              ))}
            </ul>
          )
        }

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <DescargarFicha ficha={p.fichaTecnica} titulo={p.titulo} />
          <a href={hrefConsulta} class="btn-fantasma w-full sm:w-auto">
            <Icon name="lucide:message-square" class="h-4 w-4" />
            Consultar disponibilidad
          </a>
        </div>

        <div class="mt-12 space-y-10">
          {
            p.medidas && p.medidas.length > 0 && (
              <section class="revelar">
                <h2 class="flex items-center gap-2 text-xl text-brand-ink">
                  <Icon name="lucide:ruler" class="h-5 w-5 text-brand-primary" />
                  Medidas disponibles
                </h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.medidas.map((m) => (
                    <li class="rounded-lg border border-brand-line bg-white px-3 py-2 text-sm font-medium text-brand-ink">
                      {m}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            p.presentaciones && p.presentaciones.length > 0 && (
              <section class="revelar">
                <h2 class="flex items-center gap-2 text-xl text-brand-ink">
                  <Icon name="lucide:package" class="h-5 w-5 text-brand-primary" />
                  Presentaciones
                </h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.presentaciones.map((pr) => (
                    <li class="rounded-lg border border-brand-line bg-white px-3 py-2 text-sm font-medium text-brand-ink">
                      {pr}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <ProductSpecs especificaciones={p.especificaciones} />

          <!-- Contenido libre del markdown -->
          <div class="prosa revelar">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </div>

  {
    relacionados.length > 0 && (
      <section class="border-t border-brand-line bg-brand-bg-alt py-16 sm:py-20">
        <div class="contenedor">
          <SectionTitle etiqueta="También te puede servir" titulo="Productos relacionados" />

          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {relacionados.map((r, i) => (
              <ProductCard producto={r} unidad={unidad} indice={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</UnidadLayout>
