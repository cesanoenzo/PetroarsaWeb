---
import BaseLayout from './BaseLayout.astro';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<!-- La home siempre usa el tema institucional (verde + naranja). -->
<BaseLayout titulo={titulo} descripcion={descripcion} tema="petroarsa">
  <slot />
</BaseLayout>
